{
    "$schema": "https://nitro.margelo.com/nitro.schema.json",
    "cxxNamespace": [
        "nitro_dns"
    ],
    "ios": {
        "iosModuleName": "RNDns"
    },
    "android": {
        "androidNamespace": [
            "nitro_dns"
        ],
        "androidCxxLibName": "RNDns"
    },
    "autolinking": {
        "NitroDns": {
            "cpp": "HybridDns"
        }
    },
    "cxx": {
        "extraIncludeDirs": [
            "./cpp",
            "./rust-bundle/include"
        ],
        "extraLibs": [
            "rust_c_dns"
        ],
        "extraLibDirs": [
            "./mac"
        ],
        "extraFrameworks": [
            "Security"
        ]
    },
    "ignorePaths": [
        "**/node_modules"
    ]
}